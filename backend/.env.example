# HR Agent 后端环境配置

# ============ 应用设置 ============
PROJECT_NAME=HR Agent
VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# ============ 安全配置 ============
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 数据库配置 ============
DATABASE_URL=postgresql://hr_agent_user:hr_agent_password@localhost:5432/hr_agent
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=hr_agent_user
DATABASE_PASSWORD=hr_agent_password
DATABASE_NAME=hr_agent

# ============ 远程 HR 服务 ============
HR_SERVICE_HOST=121.43.198.13
HR_SERVICE_PORT=8000
HR_SERVICE_APIKEY=your-HR_SERVICE-api-key

# ============ CORS ============
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]

# ============ LLM（兼容 OpenAI 协议的服务）============
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# ============ 重排序设置 ============
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=gte-rerank-v2
RERANK_ENABLED=true
RERANK_TOP_K=20
RERANK_FINAL_K=5

# ============ 嵌入 ============
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# ============ 知识库检索 ============
KB_QUERY_ENHANCE_ENABLED=true   # 启用查询改写功能
KB_QUERY_EXPANSION_MAX_TERMS=6   # 查询扩展最大术语数量
RAG_CONTENT_WEIGHT=0.7   # 向量相似度权重
RAG_TEXT_WEIGHT=0.3   # 文本匹配权重
CONTEXT_LIMIT=30   # 上下文配置

# ============ 向量数据库（pgvector）============
VECTOR_DIMENSION=1536

# ============ 文件上传 ============
MAX_FILE_SIZE=10485760  # 10MB（字节）
ALLOWED_FILE_TYPES=["pdf","docx","txt","md"]
UPLOAD_DIR=uploads

# ============ Dify 工作流 ============
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=you-dify-api-key
DIFY_USER_ID=hr-agent-user

# ============ 腾讯会议 MCP ============
 TENCENT_MEETING_TOKEN=your-tencent-meeting-token
TENCENT_MEETING_MCP_URL=https://mcp.meeting.tencent.com/mcp/wemeet-open/v1
TENCENT_MEETING_SKILL_VERSION=v1.1.0

# ============ 面试结果分析 ============
INTERVIEW_MEDIA_MAX_MB=500           # 上传音视频单文件上限（MB）
INTERVIEW_ANALYSIS_MAX_CHARS=60000   # 送入打分提示词的转写上限，超长时截断中间部分
INTERVIEW_ANALYSIS_MAX_TOKENS=8000   # 单次打分输出上限
INTERVIEW_LLM_SEED=42                # 面试 LLM 固定采样种子，压重复分析漂移；0 关闭
INTERVIEW_ANALYSIS_MAX_QA_PAIRS=300  # qa_pairs 落库条数上限（防护用）
INTERVIEW_QA_SINGLE_CALL_CHARS=18000 # 转写不超过该长度时一次调用抽完全部问答
INTERVIEW_QA_CHUNK_CHARS=9000        # 超长转写按该长度分块抽取
INTERVIEW_QA_MAX_TOKENS=16000        # qa_pairs 单次输出上限
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2  # 音视频转写用的 ASR 模型

# ============ 日志 ============
LOG_LEVEL=INFO  # 日志级别
# 远程服务请求/响应日志配置
REMOTE_SERVICE_LOG_ENABLED=false  # 是否输出远程服务请求/响应详情

